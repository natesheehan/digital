/* ------------------------------------------------------------------
   Design tokens
   Default: a quiet phosphor terminal.  [data-theme='light']: a clean printout.
   Window chrome is flattened to 1px hairlines in both.
   ------------------------------------------------------------------ */
:root {
	--font-display: 'VT323', 'Courier New', ui-monospace, monospace;
	--font-pixel: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
	--font-hand: 'VT323', 'Courier New', ui-monospace, monospace;
	--font-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

	--bg: #0a0c0b;
	--bg-raised: #0e1210;
	--ink: #b8f2c8;
	--ink-soft: #9fd8b0;
	--muted: #5f8a6d;
	--line: #b8f2c8;
	--line-soft: #1d2a22;
	--hatch: rgba(184, 242, 200, 0.03);
	--accent: #ffb547;
	--link: #b8f2c8;
	--visited: #9fd8b0;
	--glow: none;
	--shadow: none;
	--shadow-lg: none;

	/* chrome: every bevel collapses to a single hairline */
	--face: var(--bg-raised);
	--title-bg: transparent;
	--title-ink: var(--muted);
	--b-dark: var(--line-soft);
	--b-light: var(--line-soft);
	--b-shade: transparent;
	--b-soft: transparent;

	/* background canvas: "r g b" triplet and paper mode (0 = crt, 1 = printout) */
	--net-ink: 184 242 200;
	--paper: 0;

	--gutter: clamp(16px, 4vw, 40px);
	--measure: 64ch;
	--max: 1200px;
	--ease-out: cubic-bezier(0.16, 1, 0.3, 1);
	--ease-expo: cubic-bezier(0.19, 1, 0.22, 1);
	--ease-io: cubic-bezier(0.7, 0, 0.3, 1);

	color-scheme: dark;
}

:root[data-theme='light'] {
	--bg: #f3f2ec;
	--bg-raised: #f9f8f3;
	--ink: #151715;
	--ink-soft: #2a2d2a;
	--muted: #6b6f68;
	--line: #151715;
	--line-soft: #d9d7cc;
	--hatch: rgba(21, 23, 21, 0.03);
	--accent: #b4530a;
	--link: #151715;
	--visited: #3d403c;

	--net-ink: 21 23 21;
	--paper: 0;

	color-scheme: light;
}

/* ------------------------------------------------------------------
   Base
   ------------------------------------------------------------------ */
*,
*::before,
*::after {
	box-sizing: border-box;
}

html {
	-webkit-text-size-adjust: 100%;
	scroll-behavior: smooth;
}

body {
	margin: 0;
	background: var(--bg);
	color: var(--ink);
	font-family: var(--font-mono);
	font-size: 15px;
	line-height: 1.7;
	-webkit-font-smoothing: antialiased;
	overflow-x: hidden;
	transition: background-color 0.4s var(--ease-io), color 0.4s var(--ease-io);
}

/* the faintest scanlines — felt more than seen */
body::after {
	content: '';
	position: fixed;
	inset: 0;
	pointer-events: none;
	z-index: 101;
	background: repeating-linear-gradient(to bottom, transparent 0 3px, rgb(0 0 0 / 0.12) 3px 4px);
}

:root[data-theme='light'] body::after {
	background: none;
}

h1,
h2,
h3,
h4 {
	font-family: var(--font-display);
	font-weight: 400;
	line-height: 0.95;
	letter-spacing: 0;
	margin: 0;
	text-wrap: balance;
}

p {
	margin: 0 0 1em;
	text-wrap: pretty;
}

a {
	color: var(--link);
	text-decoration: underline;
	text-decoration-color: var(--muted);
	text-decoration-thickness: 1px;
	text-underline-offset: 0.22em;
	transition: color 0.15s, background-color 0.15s, text-decoration-color 0.15s;
}

a:visited {
	color: var(--visited);
}

a:hover {
	color: var(--accent);
	text-decoration-color: var(--accent);
}

:focus-visible {
	outline: 1px solid var(--accent);
	outline-offset: 3px;
}

::selection {
	background: var(--accent);
	color: var(--bg);
}

img,
video {
	max-width: 100%;
	display: block;
}

/* ------------------------------------------------------------------
   Building blocks
   ------------------------------------------------------------------ */
.container {
	width: 100%;
	max-width: var(--max);
	margin: 0 auto;
	padding: 0 var(--gutter);
}

.eyebrow {
	font-family: var(--font-mono);
	font-size: 0.72rem;
	letter-spacing: 0.08em;
	text-transform: uppercase;
	color: var(--muted);
}

.eyebrow.cmd {
	text-transform: none;
	letter-spacing: 0;
	font-size: 0.82rem;
	color: var(--muted);
}

/* highlighted word: just the accent colour */
.hl {
	color: var(--accent);
}

/* scanline-filled display text */
.outline {
	color: transparent;
	background: repeating-linear-gradient(to bottom, var(--ink) 0 2px, transparent 2px 4px);
	-webkit-background-clip: text;
	background-clip: text;
}

.section {
	position: relative;
	padding: clamp(72px, 11vw, 136px) 0;
	border-top: 1px solid var(--line-soft);
}

.section-head {
	display: grid;
	grid-template-columns: minmax(0, 1fr);
	gap: 14px;
	margin-bottom: clamp(32px, 5vw, 56px);
}

@media (min-width: 860px) {
	.section-head {
		grid-template-columns: 240px minmax(0, 1fr);
		align-items: baseline;
	}
}

/* a shell command, set quietly above each section */
.section-num {
	justify-self: start;
	display: inline-block;
	font-family: var(--font-mono);
	font-size: 0.78rem;
	color: var(--muted);
}

.section-num::first-letter {
	color: var(--accent);
}

.section-title {
	font-size: clamp(2.8rem, 7vw, 5.4rem);
}

.hand {
	font-family: var(--font-hand);
}

.page-head {
	position: relative;
	padding: clamp(56px, 9vw, 112px) 0 clamp(32px, 5vw, 56px);
}

.page-head > * {
	position: relative;
	z-index: 1;
}

.page-head h1 {
	font-size: clamp(3.6rem, 11vw, 8.5rem);
	margin-top: 16px;
	line-height: 0.88;
}

.page-head .lede {
	margin-top: 28px;
	max-width: 60ch;
	font-size: 0.98rem;
	color: var(--ink-soft);
}

/* ---------- window chrome, flattened ---------- */
.bevel {
	background: var(--face);
	border: 1px solid var(--line-soft);
}

.win {
	position: relative;
	padding: 0;
	background: var(--bg-raised);
	border: 1px solid var(--line-soft);
	transition: border-color 0.2s;
}

.win:hover {
	border-color: var(--muted);
}

.winbar {
	display: flex;
	align-items: center;
	gap: 8px;
	height: 30px;
	padding: 0 12px;
	background: transparent;
	color: var(--muted);
	border-bottom: 1px solid var(--line-soft);
	font-family: var(--font-mono);
	font-size: 0.68rem;
	letter-spacing: 0.06em;
	text-transform: uppercase;
	user-select: none;
}

.winbar > :first-child {
	flex: 1;
	overflow: hidden;
	white-space: nowrap;
	text-overflow: ellipsis;
}

/* three quiet status dots instead of min/max/close */
.winbtns {
	display: flex;
	gap: 6px;
}

.winbtns i {
	width: 6px;
	height: 6px;
	font-size: 0;
	background: var(--line-soft);
}

.win:hover .winbtns i:first-child {
	background: var(--accent);
}

.win-body {
	background: transparent;
}

.btn {
	display: inline-flex;
	align-items: center;
	gap: 10px;
	padding: 10px 18px;
	border: 1px solid var(--line-soft);
	background: transparent;
	color: var(--ink);
	font-family: var(--font-mono);
	font-size: 0.78rem;
	font-weight: 500;
	letter-spacing: 0.06em;
	text-transform: uppercase;
	text-decoration: none;
	cursor: pointer;
	transition: border-color 0.15s, color 0.15s, background-color 0.15s;
}

.btn:visited {
	color: var(--ink);
}

.btn:hover {
	border-color: var(--accent);
	color: var(--accent);
}

.btn:active {
	transform: translateY(1px);
}

.btn-primary,
.btn-primary:visited {
	background: var(--ink);
	border-color: var(--ink);
	color: var(--bg);
}

.btn-primary:hover {
	background: var(--accent);
	border-color: var(--accent);
	color: var(--bg);
}

.btn svg {
	width: 16px;
	height: 16px;
	flex: none;
}

.tag {
	display: inline-flex;
	align-items: center;
	gap: 6px;
	font-family: var(--font-mono);
	font-size: 0.66rem;
	text-transform: uppercase;
	letter-spacing: 0.06em;
	padding: 1px 7px;
	border: 1px solid var(--line-soft);
	color: var(--muted);
	white-space: nowrap;
}

.tag-oa {
	color: var(--ink);
	border-color: var(--muted);
}

.tag-oa svg {
	width: 11px;
	height: 11px;
}

.text-link {
	display: inline-flex;
	align-items: center;
	gap: 8px;
	font-size: 0.8rem;
	letter-spacing: 0.04em;
	text-transform: uppercase;
	text-decoration: none;
	border-bottom: 1px solid var(--muted);
	padding: 2px 0;
}

.text-link:hover {
	border-color: var(--accent);
}

/* `ls`-style result footer */
.rows {
	margin: 14px 0 0;
	font-family: var(--font-mono);
	font-size: 0.72rem;
	color: var(--muted);
}

.cursor::after {
	content: '';
	display: inline-block;
	width: 0.55em;
	height: 1em;
	margin-left: 0.15em;
	vertical-align: -0.12em;
	background: var(--accent);
	animation: blink 1.1s steps(1) infinite;
}

@keyframes blink {
	50% {
		opacity: 0;
	}
}

/* ------------------------------------------------------------------
   Scroll reveal (driven by the `reveal` action): a short rise into place
   ------------------------------------------------------------------ */
.reveal {
	opacity: 0;
	transform: translateY(12px);
	transition: opacity 0.6s var(--ease-out), transform 0.8s var(--ease-out);
	transition-delay: var(--reveal-delay, 0ms);
}

.reveal.is-visible {
	opacity: 1;
	transform: none;
}

@media (prefers-reduced-motion: reduce) {
	html {
		scroll-behavior: auto;
	}
	.reveal {
		opacity: 1;
		transform: none;
		transition: none;
	}
	*,
	*::before,
	*::after {
		animation-duration: 0.01ms !important;
		animation-iteration-count: 1 !important;
	}
}
